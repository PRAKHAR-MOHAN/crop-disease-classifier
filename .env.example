# =============================================================================
# Crop Disease & Pest Classifier - Environment Configuration
# Copy this file to .env and customize as needed.
# =============================================================================

# --- General ---
PROJECT_NAME=crop-disease-classifier
SEED=42
APP_ENV=development

# --- Workspace Paths ---
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./reports

# --- Dataset Credentials (Optional: required only for Kaggle datasets) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Experiment Tracking ---
# Options: none | wandb | mlflow
TRACKING_BACKEND=none
WANDB_API_KEY=
WANDB_PROJECT=crop-disease-classifier
WANDB_ENTITY=
MLFLOW_TRACKING_URI=./mlruns

# --- Model & Knowledge Base Paths (Backend / Gradio Demo) ---
MODEL_ONNX_PATH=./artifacts/model.onnx
MODEL_META_PATH=./artifacts/model_meta.json
PLANT_GATE_ONNX_PATH=./artifacts/plant_gate.onnx
ADVICE_KB_PATH=./configs/advice_kb.json

# --- Optional Hugging Face Hub Auto-Download (for cloud deployment) ---
HF_TOKEN=
HF_MODEL_REPO=

# --- Calibration & OOD Thresholds (overridden by model_meta.json if present) ---
UNCERTAINTY_CONF_THRESHOLD=0.55
OOD_ENERGY_THRESHOLD=-3.5
PLANT_GATE_THRESHOLD=0.45

# --- Backend API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT=60/minute
MAX_UPLOAD_MB=10
# SQLite by default; swap to postgresql+psycopg://user:pass@host:5432/dbname in prod
DATABASE_URL=sqlite:///./backend_data.sqlite3

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

